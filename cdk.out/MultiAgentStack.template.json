  "ResearchStateMachine1BD6F160": {
   "Type": "AWS::StepFunctions::StateMachine",
   "Properties": {
    "DefinitionString": {
     "Fn::Join": [
      "",
      [
       "{\"StartAt\":\"ResearchTask\",\"States\":{\"ResearchTask\":{\"Next\":\"HITLCheckpoint\",\"Retry\":[{\"ErrorEquals\":[\"Lambda.ClientExecutionTimeoutException\",\"Lambda.ServiceException\",\"Lambda.AWSLambdaException\",\"Lambda.SdkClientException\"],\"IntervalSeconds\":2,\"MaxAttempts\":6,\"BackoffRate\":2}],\"Type\":\"Task\",\"Comment\":\"Run research agent to gather information\",\"OutputPath\":\"$.Payload\",\"Resource\":\"arn:",
       {
        "Ref": "AWS::Partition"
       },
       ":states:::lambda:invoke\",\"Parameters\":{\"FunctionName\":\"",
       {
        "Fn::GetAtt": [
         "Orchestrator6EF1216F",
         "Arn"
        ]
       },
       "\",\"Payload.$\":\"$\"}},\"HITLCheckpoint\":{\"Next\":\"ApprovalDecision\",\"Retry\":[{\"ErrorEquals\":[\"Lambda.ClientExecutionTimeoutException\",\"Lambda.ServiceException\",\"Lambda.AWSLambdaException\",\"Lambda.SdkClientException\"],\"IntervalSeconds\":2,\"MaxAttempts\":6,\"BackoffRate\":2}],\"Type\":\"Task\",\"Comment\":\"Human in the loop approval checkpoint\",\"OutputPath\":\"$.Payload\",\"Resource\":\"arn:",
       {
        "Ref": "AWS::Partition"
       },
       ":states:::lambda:invoke\",\"Parameters\":{\"FunctionName\":\"",
       {
        "Fn::GetAtt": [
         "HITLApproval3D926C1D",
         "Arn"
        ]
       },
       "\",\"Payload.$\":\"$\"}},\"ApprovalDecision\":{\"Type\":\"Choice\",\"Choices\":[{\"Variable\":\"$.approval_status\",\"StringEquals\":\"approved\",\"Next\":\"WorkflowComplete\"}],\"Default\":\"WorkflowRejected\"},\"WorkflowRejected\":{\"Type\":\"Fail\",\"Error\":\"HumanRejected\",\"Cause\":\"Human reviewer rejected the research\"},\"WorkflowComplete\":{\"Type\":\"Succeed\",\"Comment\":\"Research report generated and approved\"}},\"TimeoutSeconds\":1800}"
      ]
     ]
    },
    "RoleArn": {
     "Fn::GetAtt": [
      "ResearchStateMachineRole5ACD5574",
      "Arn"
     ]
    },
    "StateMachineName": "multi-agent-research-pipeline"
   },
